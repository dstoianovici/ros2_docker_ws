# Read by docker compose (scripts/compose.sh) and by VS Code (python.envFile).
# Avoid inline comments: some readers keep them as part of the value.

# ---- Service build flags: true/false ----
# Each BUILD_<NAME>=true enables the compose profile <name> (lowercase).
# ros2      -> builds docker/Dockerfile (ROS 2 dev container)
# isaac_sim -> pulls the NVIDIA Isaac Sim image
BUILD_ROS2=true
BUILD_ISAAC_SIM=false

# ---- ROS 2 ----
# jazzy (Ubuntu 24.04) or humble (Ubuntu 22.04)
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ---- Isaac Sim ----
ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:5.1.0
ISAAC_SIM_CACHE=${HOME}/docker/isaac-sim

# ---- Container user (set by scripts/sync_ids.sh) ----
USER_UID=1000
USER_GID=1000

# ---- VS Code python analysis ----
PYTHONPATH=src:install/lib/python3.12/site-packages
